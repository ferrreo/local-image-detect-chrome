{
  "name": "truepixel",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-preserving Chrome MV3 extension that detects AI-generated images entirely in-browser via WebGPU/WASM.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .truepixel-cache coverage test-results playwright-report",
    "prepare:assets": "node scripts/generate-icons.mjs && node scripts/generate-fixtures.mjs",
    "prebuild": "npm run prepare:assets",
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "setup:models": "node scripts/setup-models.mjs",
    "setup:ort": "node scripts/setup-ort.mjs",
    "setup:ort-wasm": "node scripts/setup-ort-wasm.mjs",
    "setup:ort-web-pr29599": "node scripts/setup-ort-web-pr29599.mjs",
    "build:zig": "node scripts/build-zig.mjs",
    "build:zig-wasm": "node scripts/build-zig-wasm.mjs",
    "fetch:openrouter": "node scripts/fetch-openrouter-images.mjs",
    "fetch:real": "node scripts/fetch-real-photos.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "npm run prepare:assets && vitest run tests/unit",
    "test:watch": "vitest",
    "test:integration": "playwright test --project=integration",
    "test:eval": "playwright test --project=eval",
    "test:all": "npm run typecheck && npm run test:unit && npm run build && npm run test:integration",
    "lint": "tsc -p tsconfig.json --noEmit",
    "eval:local": "npm run prepare:assets && node scripts/eval-local.mjs",
    "eval:zig": "TRUEPIXEL_BACKEND=zig npm run eval:local",
    "eval:node": "TRUEPIXEL_BACKEND=node npm run eval:local",
    "eval:stub": "TRUEPIXEL_STUB=1 npm run eval:local",
    "eval:suite": "node scripts/eval-suite.mjs",
    "eval:suite:host": "node scripts/eval-suite-host.mjs && node scripts/eval-suite-report.mjs",
    "eval:suite:browser": "EVAL_SUITE_HOST=0 node scripts/eval-suite.mjs",
    "eval:suite:ci": "EVAL_SUITE_LIMIT=8 EVAL_SUITE_BROWSER_PROVIDERS=wasm EVAL_SUITE_XVFB=1 EVAL_SUITE_HOST_MODES=js-node-cpu-distilled,js-node-cpu-dual,zig-cpu-cascade node scripts/eval-suite.mjs",
    "eval:compare": "node scripts/eval-model-compare.mjs",
    "eval:truthlens": "python3 scripts/eval-truthlens.py",
    "distill:accurate": "python3 scripts/distill-accurate-head.py",
    "fetch:distill-corpus": "node scripts/fetch-distill-corpus.mjs",
    "ci": "npm run test:all",
    "fetch:lexica": "node scripts/fetch-lexica-images.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.2.1",
    "esbuild": "^0.25.8",
    "jsdom": "^26.1.0",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
